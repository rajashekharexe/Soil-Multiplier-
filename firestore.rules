rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Check if the user is the admin (dual check: verified email and secret UID)
    function isAdmin() {
      return request.auth != null 
        && request.auth.token.email == 'kadmultiplier@admin.com' 
        && request.auth.uid == 'a2FkbXVsdGlwbGllckBhZG1pbi5jb20=';
    }

    // Orders Collection
    match /orders/{orderId} {
      // Require authenticated user creating their own order with valid schema
      allow create: if request.auth != null 
        && request.resource.data.uid == request.auth.uid 
        && request.resource.data.keys().hasAll(['items', 'total', 'paymentMethod', 'shippingAddress', 'createdAt'])
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.items.size() <= 20
        && request.resource.data.total is number
        && request.resource.data.total > 0
        && (request.resource.data.paymentMethod != 'QR_CODE' || (request.resource.data.keys().hasAll(['utr']) && request.resource.data.utr.size() >= 12));
      
      // Users can only read their own orders. Admin can read all.
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == resource.data.uid);
      
      // Only admin can update or delete orders
      allow update, delete: if isAdmin();
    }

    // Addresses Collection
    match /addresses/{addressId} {
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == resource.data.uid);
      allow update: if request.auth != null 
        && request.auth.uid == resource.data.uid 
        && request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null && request.auth.uid == resource.data.uid;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
    }

    // Wishlist Collection
    match /wishlist/{wishlistId} {
      allow read, delete: if request.auth != null && request.auth.uid == resource.data.uid;
      allow update: if request.auth != null 
        && request.auth.uid == resource.data.uid 
        && request.resource.data.uid == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
    }

    // Products Collection (Prices/Stock)
    match /products/{productId} {
      // Anyone can read prices
      allow read: if true;
      // Only admin can edit prices and stock
      allow write: if isAdmin();
    }

    // Leads Collection (Contact forms with strict anti-bot schema validation)
    match /leads/{leadId} {
      allow create: if request.resource.data.keys().hasAll(['name', 'phone', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 100
        && request.resource.data.phone is string
        && request.resource.data.phone.matches('^[6-9][0-9]{9}$');
      allow read, update, delete: if isAdmin();
    }

    // Users Collection (Profile data)
    match /users/{userId} {
      // Users can only read/write their own profile
      allow read, write: if isAdmin() || (request.auth != null && request.auth.uid == userId);
    }
  }
}
